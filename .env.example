# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string (e.g. Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Long random string for signing the login cookie
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: any email/password signs in (default on outside production). Set false for public deployments.
# DEMO_MODE=true

# Optional: pin a WebLLM model
# NEXT_PUBLIC_WEBLLM_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC
